{
	"name": "escalas",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate": "npx tsx scripts/migrate.ts",
		"db:migrate:staging": "npx tsx scripts/migrate.ts --remote --staging",
		"db:migrate:prod": "npx tsx scripts/migrate.ts --remote",
		"users:set-default-password": "npx tsx scripts/set-default-password-all-users.ts",
		"users:set-default-password:prod": "npx tsx scripts/set-default-password-all-users.ts --remote",
		"users:clear-passwords-non-admins": "npx tsx scripts/clear-passwords-non-admins.ts",
		"users:clear-passwords-non-admins:prod": "npx tsx scripts/clear-passwords-non-admins.ts --remote",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"lint": "eslint src/",
		"lint:strict": "eslint --max-warnings 0 src/",
		"lint:ci": "eslint --max-warnings 0 src/",
		"docs:inventario": "node scripts/inventario-docs.mjs",
		"docs:guard": "node scripts/guard-docs-novos.mjs",
		"guard:autorizacao": "node scripts/guard-autorizacao.mjs",
		"guard:duplicacao": "node scripts/guard-duplicacao.mjs",
		"guard:achados": "node scripts/guard-achados.mjs",
		"guard:entrada": "node scripts/guard-entrada.mjs",
		"lint:fix": "eslint --fix src/",
		"format": "prettier --write src/",
		"format:check": "prettier --check src/",
		"format:e2e": "prettier --write e2e/",
		"format:check:e2e": "prettier --check e2e/",
		"knip": "knip",
		"knip:fix": "knip --fix"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260815.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-cloudflare": "^7.0.0",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node-forge": "^1.3.14",
		"@vitest/coverage-v8": "^4.1.10",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.7.0",
		"knip": "^6.27.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-visualizer": "^7.0.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tsx": "^4.23.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.10",
		"wrangler": "^4.123.0"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.0"
		},
		"uuid": "^11.1.1",
		"dompurify": "^3.4.14"
	},
	"dependencies": {
		"@fontsource/inter": "^5.2.8",
		"@lucide/svelte": "^1.28.0",
		"@sentry/browser": "^10.59.0",
		"@sentry/cloudflare": "^10.66.0",
		"@signpdf/placeholder-pdf-lib": "^3.3.0",
		"@signpdf/utils": "^3.3.0",
		"@skeletonlabs/skeleton": "^4.13.0",
		"@skeletonlabs/skeleton-svelte": "^4.15.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/qrcode": "^1.5.6",
		"@vladmandic/face-api": "^1.7.15",
		"chart.js": "^4.5.1",
		"docx": "^9.0.0",
		"drizzle-orm": "^0.45.1",
		"exceljs": "^4.4.0",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"node-forge": "^1.3.3",
		"pdf-lib": "^1.17.1",
		"qrcode": "^1.5.4",
		"tailwindcss": "^4.3.3",
		"zod": "^4.4.3"
	}
}
